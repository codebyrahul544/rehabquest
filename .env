# =====================================================================
#  RehabQuest settings  -  edit values here, no code changes needed.
#  Restart the app after editing. See TUNING.md for what each one does.
#  (Real environment variables override this file.)
# =====================================================================

# ---------- Camera & window ----------
CAMERA_INDEX=0                 # 0 = built-in webcam, 1/2 = USB cameras
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
MIRROR=1                       # 1 = mirror view (recommended)
START_FULLSCREEN=0             # press F to toggle at any time
TARGET_FPS=30
DETECT_WIDTH=640               # image width sent to MediaPipe (lower = faster, less accurate)
MIN_BRIGHTNESS=60              # 0-255; calibration warns below this

# ---------- Sound ----------
SOUND=1
MUSIC=1                        # soft background pad (M mutes everything)
VOLUME=0.7
MUSIC_VOLUME=0.10

# ---------- Session & interaction ----------
REST_REMINDER_MINUTES=10       # "Take a rest" screen after this much play time
REST_SECONDS=60
HOVER_CLICK_SECONDS=1.5        # hold hand over a button this long to click
START_GATE_SECONDS=2.0         # body part visible this long to start a game
PAIN_GESTURE_SECONDS=1.5       # crossed hands held this long = stop
EASE_STEP=0.10                 # each "help level" after 2 fails eases targets by 10%

# ---------- Tracking ----------
SMOOTHING_ALPHA=0.55           # 0.3 = smoother/laggier, 0.8 = snappier/jittery
TRACKING_LOST_GRACE=0.35       # seconds before "I can't see you" pauses the timer
MIN_DETECTION_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
HANDEDNESS_SWAP=0              # set 1 if LEFT/RIGHT hands are reported the wrong way round
FACE_SIDE_SWAP=1               # set 0 if the facial L/R bars are the wrong way round

# ---------- Hand geometry (Games 2 and 5) ----------
OPEN_RATIO_DEFAULT=1.85        # used until calibration measures your own hand
FIST_RATIO_DEFAULT=1.05
FINGER_EXTENDED_MAX_DEG=80     # finger counts as straight below this total bend
FINGER_CURLED_MIN_DEG=110      # finger counts as curled above this total bend
THUMB_EXTENDED_RATIO=0.95
PINCH_THRESHOLD=0.35           # thumb-tip to finger-tip / hand size

# ---------- Game 1: Bubble Garden (EASY) ----------
G1_PASS_POPS=15
G1_TIME_LIMIT=90
G1_SPAWN_INTERVAL=2.2
G1_BUBBLE_RADIUS=62
G1_TOUCH_MARGIN=28
G1_HOVER_SECONDS=6.0

# ---------- Game 2: Lantern Lighter (EASY) ----------
G2_PASS_LANTERNS=8
G2_TIME_LIMIT=120
G2_OPEN_HOLD=2.0
G2_FIST_HOLD=1.0
G2_OPEN_THRESHOLD=0.72         # 0-1 of YOUR calibrated range
G2_FIST_THRESHOLD=0.30

# ---------- Game 3: Smile Sunshine (EASY) ----------
G3_TIME_LIMIT=150
G3_HOLD=2.0
G3_SYMMETRY_THRESHOLD=0.55     # relaxed for easy mode (1.0 = perfectly even)
G3_SMILE_THRESHOLD=0.45
G3_BROW_THRESHOLD=0.35
G3_EYES_THRESHOLD=0.50
G3_PUCKER_THRESHOLD=0.45
G3_JAW_THRESHOLD=0.40
G3_HALF_SMILE_DIFF=0.20

# ---------- Game 4: Mirror Dancer (MEDIUM) ----------
G4_POSE_ACCURACY=0.75
G4_PASS_POSES=10
G4_TOTAL_POSES=12
G4_POSE_WINDOW=7.0             # seconds per pose (the beat ring)
G4_HOLD=0.5
G4_TOLERANCE_SCALE=1.0         # 1.2 = every angle tolerance 20% wider

# ---------- Game 5: Spell Caster (HARD) ----------
G5_ROUNDS=5
G5_MAX_MISTAKES=3
G5_STEP_TIME_START=9.0
G5_STEP_TIME_END=6.0
G5_HOLD=0.45
